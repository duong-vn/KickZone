}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fields {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_type_id         String                  @db.Uuid
  name                  String
  slug                  String                  @unique(map: "uq_fields_slug")
  description           String?
  address               String
  city                  String
  district              String
  latitude              Decimal?                @db.Decimal(9, 6)
  longitude             Decimal?                @db.Decimal(9, 6)
  base_price_per_hour   Int
  status                field_status            @default(ACTIVE)
  deleted_at            DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  bookings              bookings[]
  favorites             favorites[]
  field_images          field_images[]
  field_operating_hours field_operating_hours[]
  field_types           field_types             @relation(fields: [field_type_id], references: [id], onUpdate: Restrict, map: "fk_fields_field_type")
  price_rules           price_rules[]
  reviews               reviews[]

  @@index([base_price_per_hour], map: "idx_fields_base_price")
  @@index([district], map: "idx_fields_district")
  @@index([field_type_id], map: "idx_fields_field_type")
  @@index([status, deleted_at], map: "idx_fields_status_deleted")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model price_rules {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id       String    @db.Uuid
  name           String
  day_of_week    Int?      @db.SmallInt
  start_time     DateTime  @db.Time(6)
  end_time       DateTime  @db.Time(6)
  price_per_hour Int
  effective_from DateTime? @db.Date
  effective_to   DateTime? @db.Date
  priority       Int       @default(0)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  fields         fields    @relation(fields: [field_id], references: [id], onDelete: Cascade, map: "fk_price_rules_field")

  @@index([field_id, is_active, day_of_week, effective_from, effective_to, start_time, end_time], map: "idx_price_rules_lookup")
}

