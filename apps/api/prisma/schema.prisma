model favorites {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  field_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  fields     fields   @relation(fields: [field_id], references: [id], onDelete: Cascade, map: "fk_favorites_field")
  profiles   profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_favorites_user")

  @@unique([user_id, field_id], map: "uq_favorites_user_field")
  @@index([user_id, created_at(sort: Desc)], map: "idx_favorites_user_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model field_images {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id     String   @db.Uuid
  storage_path String
  alt_text     String?
  sort_order   Int      @default(0)
  is_primary   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  fields       fields   @relation(fields: [field_id], references: [id], onDelete: Cascade, map: "fk_field_images_field")

  @@unique([field_id], map: "ux_field_images_one_primary", where: raw("(is_primary = true)"))
  @@index([field_id, sort_order, created_at], map: "idx_field_images_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
