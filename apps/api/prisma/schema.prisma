  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  fields      fields    @relation(fields: [field_id], references: [id], onDelete: Cascade, map: "fk_field_operating_hours_field")

  @@unique([field_id, day_of_week], map: "uq_field_operating_hours_day")
