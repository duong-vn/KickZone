/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id   String           @unique(map: "uq_profiles_auth_user_id") @db.Uuid
  email          String
  full_name      String?
  avatar_path    String?
  phone          String?
  role           user_role        @default(USER)
  status         user_status      @default(ACTIVE)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  bookings       bookings[]
  favorites      favorites[]
  reviews        reviews[]
  voucher_usages voucher_usages[]

  @@index([email], map: "idx_profiles_email")
  @@index([status], map: "idx_profiles_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  field_id   String   @db.Uuid
  booking_id String   @db.Uuid
  rating     Int      @db.SmallInt
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  bookings   bookings @relation(fields: [booking_id, user_id, field_id], references: [id, user_id, field_id], onUpdate: Restrict, map: "fk_reviews_eligible_booking")
  fields     fields   @relation(fields: [field_id], references: [id], onUpdate: Restrict, map: "fk_reviews_field")
  profiles   profiles @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_reviews_user")

  @@unique([booking_id, user_id, field_id], map: "uq_reviews_booking")
  @@index([field_id, created_at(sort: Desc)], map: "idx_reviews_field_created")
  @@index([user_id, created_at(sort: Desc)], map: "idx_reviews_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model voucher_usages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_id String   @db.Uuid
  user_id    String   @db.Uuid
  booking_id String   @db.Uuid
  used_at    DateTime @default(now()) @db.Timestamptz(6)
  bookings   bookings @relation(fields: [booking_id, user_id, voucher_id], references: [id, user_id, voucher_id], onUpdate: Restrict, map: "fk_voucher_usages_booking")
  profiles   profiles @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_voucher_usages_user")
  vouchers   vouchers @relation(fields: [voucher_id], references: [id], onUpdate: Restrict, map: "fk_voucher_usages_voucher")

  @@unique([booking_id, user_id, voucher_id], map: "uq_voucher_usages_booking")
  @@index([voucher_id, user_id, used_at], map: "idx_voucher_usages_user")
  @@index([voucher_id, used_at], map: "idx_voucher_usages_voucher")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vouchers {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "uq_vouchers_code")
  discount_type   discount_type
  value           Int
  max_discount    Int?
  min_order_value Int?
  start_at        DateTime?        @db.Timestamptz(6)
  end_at          DateTime?        @db.Timestamptz(6)
  usage_limit     Int?
  per_user_limit  Int?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  bookings        bookings[]
  voucher_usages  voucher_usages[]

  @@index([is_active, start_at, end_at], map: "idx_vouchers_active_window")
}

enum booking_status {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum discount_type {
  PERCENT
  FIXED
}

enum field_status {
  ACTIVE
  INACTIVE
}

enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  INACTIVE
}
